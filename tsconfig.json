{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true
  },
  "include": [
    "vendor/mini-games-kit/src/**/*.ts",
    "vendor/mini-games-kit/tests/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "vite.config.ts"
  ]
}
